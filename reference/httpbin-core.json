{
  "openapi": "3.0.3",
  "info": {
    "title": "HTTPBin Core",
    "version": "1.0.0",
    "description": "Request and response endpoints used for MCP Metrics QA. Every operation reaches a live server, so `execute-request` records a real status code and response time."
  },
  "servers": [
    {
      "url": "https://httpbin.io",
      "description": "Primary"
    },
    {
      "url": "https://httpbingo.org",
      "description": "Fallback"
    }
  ],
  "paths": {
    "/get": {
      "get": {
        "operationId": "echoGet",
        "summary": "Echo a GET request",
        "responses": {
          "200": {
            "description": "Echoed request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/post": {
      "post": {
        "operationId": "echoPost",
        "summary": "Echo a POST body",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Echoed body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/status/{code}": {
      "get": {
        "operationId": "returnStatus",
        "summary": "Return a given status code",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "HTTP status code to return.",
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599,
              "example": 404
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Response with the requested status code"
          }
        }
      }
    },
    "/headers": {
      "get": {
        "operationId": "returnHeaders",
        "summary": "Return the request headers",
        "responses": {
          "200": {
            "description": "The request headers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/delay/{seconds}": {
      "get": {
        "operationId": "delayResponse",
        "summary": "Respond after a delay",
        "parameters": [
          {
            "name": "seconds",
            "in": "path",
            "required": true,
            "description": "Seconds to wait before responding.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "example": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delayed response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/uuid": {
      "get": {
        "summary": "Generate a UUID",
        "description": "Returns one randomly generated UUID (v4) by default. Set `count` to get up to 10 UUIDs in one request. When `count` is 1 or left out, the response has a single `uuid` field. When `count` is greater than 1, the response has a `uuids` array instead.",
        "operationId": "generateUuid",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "Number of UUIDs to generate. Must be an integer from 1 to 10. Values outside this range return a 400 error.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The generated UUID or UUIDs. Returns `{ \"uuid\": \"...\" }` when `count` is 1 or left out, and `{ \"uuids\": [...] }` when `count` is greater than 1.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "title": "Single UUID",
                      "properties": {
                        "uuid": {
                          "type": "string",
                          "format": "uuid",
                          "description": "A randomly generated UUID."
                        }
                      },
                      "required": [
                        "uuid"
                      ]
                    },
                    {
                      "type": "object",
                      "title": "Multiple UUIDs",
                      "properties": {
                        "uuids": {
                          "type": "array",
                          "description": "The randomly generated UUIDs. The array length matches `count`.",
                          "minItems": 2,
                          "maxItems": 10,
                          "items": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      },
                      "required": [
                        "uuids"
                      ]
                    }
                  ]
                },
                "examples": {
                  "single": {
                    "summary": "count omitted or count=1",
                    "value": {
                      "uuid": "3f2b8c1e-9a4d-4e7b-8c2a-1d5f6e7a8b9c"
                    }
                  },
                  "multiple": {
                    "summary": "count=3",
                    "value": {
                      "uuids": [
                        "3f2b8c1e-9a4d-4e7b-8c2a-1d5f6e7a8b9c",
                        "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
                        "9e8d7c6b-5a4f-4e3d-9c2b-1a0f9e8d7c6b"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`count` is not an integer from 1 to 10.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "example": 400
                    },
                    "error": {
                      "type": "string",
                      "example": "Bad Request"
                    },
                    "message": {
                      "type": "string",
                      "example": "querystring/count must be <= 10"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}